# ── Database ──────────────────────────────────────────────
# Default is SQLite (zero setup). For MySQL, use e.g.:
#   DATABASE_URL=mysql+pymysql://root@localhost:3308/receipt_manager
DATABASE_URL=sqlite:///./data/savy.db

# ── Security ──────────────────────────────────────────────
# Fernet key used to encrypt stored IMAP passwords.
# Generate one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SECRET_KEY=change-me-to-a-long-random-string

# ── LLM (OpenAI-compatible endpoint) ──────────────────────
# Works with real OpenAI or a proxy such as KKU IntelSphere.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://gen.ai.kku.ac.th/api/v1
LLM_MODEL=qwen3.7-max
# Multimodal model that reads slip / receipt images.
# gemini-2.5-flash = best Thai OCR / cheap / fast. Swap for gpt-5 if preferred.
VISION_MODEL=gemini-2.5-flash

# ── Vector store (Qdrant) ─────────────────────────────────
# Embedded file mode (default, no server). Use http://localhost:6333 for a server.
QDRANT_LOCATION=./data/qdrant
QDRANT_COLLECTION=receipts
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Agent ─────────────────────────────────────────────────
MAX_TOOL_ITERATIONS=6
